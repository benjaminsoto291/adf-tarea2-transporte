{
	"name": "df_silver_vehiculos",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "sql_dw_bronze_vehiculos_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "sql_dw_silver_vehiculos_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "filter1"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          VehiculoId as string,",
				"          Placa as string,",
				"          TipoVehiculo as string,",
				"          CapacidadEfectiva as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(VehiculoId = trim(VehiculoId),",
				"          Placa = upper(trim(Placa)),",
				"          Estado = upper(trim(Estado)),",
				"          TipoVehiculo = upper(trim(TipoVehiculo))) ~> derivedColumn1",
				"derivedColumn1 derive(CapacidadEfectiva = toInteger(trim(CapacidadEfectiva)),",
				"          VigenciaDesde = coalesce(\r",
				"  toDate(trim(toString(VigenciaDesde)), 'dd/MM/yyyy'),\r",
				"  toDate(trim(toString(VigenciaDesde)), 'd/M/yyyy'),\r",
				"  toDate(substring(trim(toString(VigenciaDesde)), 1, 10), 'yyyy-MM-dd'),\r",
				"  toDate('1900-01-01', 'yyyy-MM-dd')\r",
				"),",
				"          VigenciaHasta = coalesce(\r",
				"  toDate(trim(toString(VigenciaHasta)), 'dd/MM/yyyy'),\r",
				"  toDate(trim(toString(VigenciaHasta)), 'd/M/yyyy'),\r",
				"  toDate(substring(trim(toString(VigenciaHasta)), 1, 10), 'yyyy-MM-dd'),\r",
				"  toDate('9999-12-31', 'yyyy-MM-dd')\r",
				")) ~> derivedColumn2",
				"derivedColumn2 filter(!isNull(VehiculoId) && trim(toString(VehiculoId)) != '' && lower(trim(toString(VehiculoId))) != 'null') ~> filter1",
				"filter1 aggregate(groupBy(VehiculoId),",
				"     AnioFuente = max(AnioFuente),",
				"          Placa = first(Placa),",
				"          TipoVehiculo = first(TipoVehiculo),",
				"          CapacidadEfectiva = first(CapacidadEfectiva),",
				"          VigenciaDesde = first(VigenciaDesde),",
				"          VigenciaHasta = first(VigenciaHasta),",
				"          Estado = first(Estado)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          VehiculoId as string,",
				"          Placa as string,",
				"          TipoVehiculo as string,",
				"          CapacidadEfectiva as integer,",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          VehiculoId,",
				"          Placa,",
				"          TipoVehiculo,",
				"          CapacidadEfectiva,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     )) ~> sink1"
			]
		}
	}
}