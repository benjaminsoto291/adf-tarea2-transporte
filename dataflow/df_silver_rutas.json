{
	"name": "df_silver_rutas",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "sql_dw_bronze_rutas_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "sql_dw_silver_rutas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          RutaHistoricaId as string,",
				"          CodigoRuta as string,",
				"          NombreRuta as string,",
				"          Origen as string,",
				"          Destino as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(RutaHistoricaId = iif(isNull(RutaHistoricaId) || trim(toString(RutaHistoricaId)) == '' || lower(trim(toString(RutaHistoricaId))) == 'null',\r",
				"    concat('RH-', lpad(toString(regexReplace(trim(toString(CodigoRuta)), '[^0-9]', '')), 2, '0')),\r",
				"    trim(toString(RutaHistoricaId))\r",
				"),",
				"          CodigoRuta = trim(toString(CodigoRuta)),",
				"          NombreRuta = trim(toString(NombreRuta)),",
				"          Origen = trim(toString(Origen)),",
				"          Destino = trim(toString(Destino)),",
				"          Estado = upper(trim(toString(Estado)))) ~> derivedColumn1",
				"derivedColumn1 derive(VigenciaDesde = iif(isNull(VigenciaDesde) || trim(toString(VigenciaDesde)) == '', toDate(null()), iif(instr(toString(VigenciaDesde), '/') > 0, toDate(trim(toString(VigenciaDesde)), 'dd/MM/yyyy'), toDate(trim(toString(VigenciaDesde)), 'yyyy-MM-dd'))),",
				"          VigenciaHasta = iif(isNull(VigenciaHasta) || trim(toString(VigenciaHasta)) == '', toDate(null()), iif(instr(toString(VigenciaHasta), '/') > 0, toDate(trim(toString(VigenciaHasta)), 'dd/MM/yyyy'), toDate(trim(toString(VigenciaHasta)), 'yyyy-MM-dd')))) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          RutaHistoricaId as string,",
				"          CodigoRuta as string,",
				"          NombreRuta as string,",
				"          Origen as string,",
				"          Destino as string,",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          RutaHistoricaId,",
				"          CodigoRuta,",
				"          NombreRuta,",
				"          Origen,",
				"          Destino,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     )) ~> sink1"
			]
		}
	}
}