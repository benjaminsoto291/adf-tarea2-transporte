{
	"name": "df_silver_viajes",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "sql_dw_bronze_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "sql_dw_silver_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as string,",
				"          HoraProgramada as string,",
				"          HoraSalida as string,",
				"          HoraLlegada as string,",
				"          ValidacionesTarjeta as string,",
				"          KmRecorridos as string,",
				"          EstadoViaje as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(ViajeId = upper(trim(toString(ViajeId))),",
				"          RutaHistoricaId = trim(toString(RutaHistoricaId)),",
				"          VehiculoId = upper(trim(toString(VehiculoId))),",
				"          EstadoViaje = upper(trim(toString(EstadoViaje)))) ~> derivedColumn1",
				"derivedColumn1 derive(FechaServicio = iif(instr(toString(FechaServicio), '/') > 0, toDate(trim(toString(FechaServicio)), 'dd/MM/yyyy'), toDate(trim(toString(FechaServicio)), 'yyyy-MM-dd')),",
				"          HoraProgramada = toTimestamp(concat('1900-01-01 ', trim(toString(HoraProgramada))), 'yyyy-MM-dd HH:mm'),",
				"          HoraSalida = toTimestamp(concat('1900-01-01 ', trim(toString(HoraSalida))), 'yyyy-MM-dd HH:mm'),",
				"          HoraLlegada = toTimestamp(concat('1900-01-01 ', trim(toString(HoraLlegada))), 'yyyy-MM-dd HH:mm')) ~> derivedColumn2",
				"derivedColumn2 derive(ValidacionesTarjeta = iif(isNull(ValidacionesTarjeta) || trim(toString(ValidacionesTarjeta)) == '' || lower(trim(toString(ValidacionesTarjeta))) == 'null', 0, toInteger(ValidacionesTarjeta)),",
				"          KmRecorridos = toDecimal(replace(toString(KmRecorridos), ',', '.'), 10, 2)) ~> derivedColumn3",
				"derivedColumn3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as date,",
				"          HoraProgramada as timestamp,",
				"          HoraSalida as timestamp,",
				"          HoraLlegada as timestamp,",
				"          ValidacionesTarjeta as integer,",
				"          KmRecorridos as decimal(8,1),",
				"          EstadoViaje as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          ViajeId,",
				"          RutaHistoricaId,",
				"          VehiculoId,",
				"          FechaServicio,",
				"          HoraProgramada,",
				"          HoraSalida,",
				"          HoraLlegada,",
				"          ValidacionesTarjeta,",
				"          KmRecorridos,",
				"          EstadoViaje",
				"     )) ~> sink1"
			]
		}
	}
}