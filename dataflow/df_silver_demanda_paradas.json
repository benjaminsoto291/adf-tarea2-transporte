{
	"name": "df_silver_demanda_paradas",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "sql_dw_demanda_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "sql_dw_silver_demanda_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          DemandaId as string,",
				"          FechaServicio as string,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as string,",
				"          Descensos as string,",
				"          DemandaNoAtendida as string,",
				"          Metodo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT AnioFuente, DemandaId, FechaServicio, RutaHistoricaId, ParadaHistoricaId,\\n       Franja, ValidacionesTarjeta, Descensos, DemandaNoAtendida, Metodo\\nFROM bronze.DemandaParadas\\nWHERE DemandaId IS NOT NULL',",
				"     format: 'query') ~> source1",
				"source1 derive(FechaServicio = coalesce(toDate(trim(toString(FechaServicio)), 'dd/MM/yyyy'), toDate(trim(toString(FechaServicio)), 'd/M/yyyy'), toDate(substring(trim(toString(FechaServicio)), 1, 10), 'yyyy-MM-dd'), toDate('1900-01-01', 'yyyy-MM-dd'))) ~> derivedColumn1",
				"derivedColumn1 derive(RutaHistoricaId = trim(RutaHistoricaId),",
				"          ParadaHistoricaId = upper(trim(ParadaHistoricaId)),",
				"          Franja = iif(isNull(Franja) || trim(toString(Franja)) == '', 'SIN FRANJA', trim(toString(Franja))),",
				"          Metodo = iif(isNull(Metodo) || trim(toString(Metodo)) == '', 'SIN METODO', trim(toString(Metodo)))) ~> derivedColumn2",
				"derivedColumn2 derive(ValidacionesTarjeta = coalesce(toInteger(trim(toString(ValidacionesTarjeta))), 0),",
				"          Descensos =      coalesce(toInteger(trim(toString(Descensos))), 0),",
				"          DemandaNoAtendida = coalesce(toInteger(trim(toString(DemandaNoAtendida))), 0)) ~> derivedColumn3",
				"derivedColumn3 aggregate(groupBy(DemandaId),",
				"     AnioFuente = max(AnioFuente),",
				"          FechaServicio = first(FechaServicio),",
				"          RutaHistoricaId = first(RutaHistoricaId),",
				"          ParadaHistoricaId = first(ParadaHistoricaId),",
				"          Franja = first(Franja),",
				"          ValidacionesTarjeta = first(ValidacionesTarjeta),",
				"          Descensos = first(Descensos),",
				"          DemandaNoAtendida = first(DemandaNoAtendida),",
				"          Metodo = first(Metodo)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          DemandaId as string,",
				"          FechaServicio as date,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as integer,",
				"          Descensos as integer,",
				"          DemandaNoAtendida as integer,",
				"          Metodo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          DemandaId,",
				"          FechaServicio,",
				"          RutaHistoricaId,",
				"          ParadaHistoricaId,",
				"          Franja,",
				"          ValidacionesTarjeta,",
				"          Descensos,",
				"          DemandaNoAtendida,",
				"          Metodo",
				"     )) ~> sink1"
			]
		}
	}
}