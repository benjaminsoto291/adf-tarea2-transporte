{
	"name": "df_silver_paradas",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "sql_dw_bronze_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "sql_dw_silver_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ParadaHistoricaId as string,",
				"          CodigoPublicado as string,",
				"          NombreParada as string,",
				"          Zona as string,",
				"          Latitud as string,",
				"          Longitud as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(ParadaHistoricaId = iif(isNull(ParadaHistoricaId) || trim(toString(ParadaHistoricaId)) == '' || lower(trim(toString(ParadaHistoricaId))) == 'null', '', trim(toString(ParadaHistoricaId))),",
				"          NombreParada = iif(isNull(NombreParada) || trim(toString(NombreParada)) == '' || lower(trim(toString(NombreParada))) == 'null', 'SIN NOMBRE', trim(toString(NombreParada))),",
				"          Zona = iif(isNull(Zona) || trim(toString(Zona)) == '', 'SIN ZONA', trim(toString(Zona))),",
				"          Estado = iif(isNull(Estado) || trim(toString(Estado)) == '', 'SIN ESTADO', trim(toString(Estado))),",
				"          CodigoPublicado = iif(isNull(CodigoPublicado) || trim(toString(CodigoPublicado)) == '', 'SIN CODIGO', trim(toString(CodigoPublicado)))) ~> derivedColumn1",
				"derivedColumn1 derive(Latitud = coalesce(toDecimal(trim(toString(Latitud)), 9, 6), toDecimal(0, 9, 6)),",
				"          Longitud = coalesce(toDecimal(trim(toString(Longitud)), 9, 6), toDecimal(0, 9, 6))) ~> derivedColumn2",
				"derivedColumn2 derive(VigenciaDesde = coalesce(\r",
				"  toDate(trim(toString(VigenciaDesde)), 'dd/MM/yyyy'),\r",
				"  toDate(trim(toString(VigenciaDesde)), 'd/M/yyyy'),\r",
				"  toDate(substring(trim(toString(VigenciaDesde)), 1, 10), 'yyyy-MM-dd'),\r",
				"  toDate('1900-01-01', 'yyyy-MM-dd')\r",
				"),",
				"          VigenciaHasta = coalesce(\r",
				"  toDate(trim(toString(VigenciaHasta)), 'dd/MM/yyyy'),\r",
				"  toDate(trim(toString(VigenciaHasta)), 'd/M/yyyy'),\r",
				"  toDate(substring(trim(toString(VigenciaHasta)), 1, 10), 'yyyy-MM-dd'),\r",
				"  toDate('9999-12-31', 'yyyy-MM-dd')\r",
				")) ~> derivedColumn3",
				"filter1 aggregate(groupBy(ParadaHistoricaId),",
				"     CodigoPublicado = first(CodigoPublicado),",
				"          NombreParada = first(NombreParada),",
				"          Zona = first(Zona),",
				"          Latitud = first(Latitud),",
				"          Longitud = first(Longitud),",
				"          VigenciaDesde = first(VigenciaDesde),",
				"          VigenciaHasta = first(VigenciaHasta),",
				"          Estado = first(Estado),",
				"          AnioFuente = max(AnioFuente)) ~> aggregate1",
				"derivedColumn3 filter(!isNull(ParadaHistoricaId) && trim(toString(ParadaHistoricaId)) != '') ~> filter1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ParadaHistoricaId as string,",
				"          CodigoPublicado as string,",
				"          NombreParada as string,",
				"          Zona as string,",
				"          Latitud as decimal(9,6),",
				"          Longitud as decimal(9,6),",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          ParadaHistoricaId,",
				"          CodigoPublicado,",
				"          NombreParada,",
				"          Zona,",
				"          Latitud,",
				"          Longitud,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     )) ~> sink1"
			]
		}
	}
}