{
	"name": "df_silver_paradas",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "sql_dw_bronze_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "sql_dw_silver_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ParadaHistoricaId as string,",
				"          CodigoPublicado as string,",
				"          NombreParada as string,",
				"          Zona as string,",
				"          Latitud as string,",
				"          Longitud as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(ParadaHistoricaId = iif(isNull(ParadaHistoricaId) || trim(toString(ParadaHistoricaId)) == '' || lower(trim(toString(ParadaHistoricaId))) == 'null',\r",
				"    'P000',\r",
				"    trim(toString(ParadaHistoricaId))\r",
				"),",
				"          NombreParada = trim(NombreParada),",
				"          Zona = upper(trim(Zona)),",
				"          Estado = upper(trim(Estado)),",
				"          CodigoPublicado = iif(isNull(CodigoPublicado) || trim(toString(CodigoPublicado)) == '' || lower(trim(toString(CodigoPublicado))) == 'null', '', trim(toString(CodigoPublicado)))) ~> derivedColumn1",
				"derivedColumn1 derive(Latitud = toDecimal(trim(Latitud)),",
				"          Longitud = toDecimal(trim(Longitud))) ~> derivedColumn2",
				"derivedColumn2 derive(VigenciaDesde = iif(\r",
				"  isNull(VigenciaDesde) || trim(toString(VigenciaDesde)) == '' || lower(trim(toString(VigenciaDesde))) == 'null',\r",
				"  toDate('1900-01-01', 'yyyy-MM-dd'),\r",
				"  iif(\r",
				"    locate('/', toString(VigenciaDesde)) > 0,\r",
				"    toDate(trim(toString(VigenciaDesde)), 'dd/MM/yyyy'),\r",
				"    toDate(trim(toString(VigenciaDesde)), 'yyyy-MM-dd')\r",
				"  )\r",
				"),",
				"          VigenciaHasta = iif(isNull(VigenciaHasta) || trim(toString(VigenciaHasta)) == '' || lower(trim(toString(VigenciaHasta))) == 'null',\r",
				"    toDate('9999-12-31', 'yyyy-MM-dd'),\r",
				"    iif(instr(toString(VigenciaHasta), '/') > 0, \r",
				"        toDate(trim(toString(VigenciaHasta)), 'dd/MM/yyyy'), \r",
				"        toDate(trim(toString(VigenciaHasta)), 'yyyy-MM-dd')\r",
				"    )\r",
				")) ~> derivedColumn3",
				"derivedColumn3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ParadaHistoricaId as string,",
				"          CodigoPublicado as string,",
				"          NombreParada as string,",
				"          Zona as string,",
				"          Latitud as decimal(9,6),",
				"          Longitud as decimal(9,6),",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          ParadaHistoricaId,",
				"          CodigoPublicado,",
				"          NombreParada,",
				"          Zona,",
				"          Latitud,",
				"          Longitud,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     )) ~> sink1"
			]
		}
	}
}