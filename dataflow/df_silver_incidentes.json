{
	"name": "df_silver_incidentes",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "sql_bronze_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "sql_dw_silver_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as integer,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as timestamp,",
				"          FechaHoraFin as timestamp,",
				"          FechaHoraRegistro as timestamp,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(IncidenteId = upper(trim(IncidenteId)),",
				"          TipoIncidente = upper(trim(TipoIncidente)),",
				"          Severidad = upper(trim(Severidad)),",
				"          VehiculoId = iif(isNull(VehiculoId) || trim(VehiculoId) == '' || lower(trim(VehiculoId)) == 'null', toString(null()), upper(trim(VehiculoId))),",
				"          Descripcion = trim(Descripcion)) ~> derivedColumn1",
				"derivedColumn1 derive(FechaHoraInicio = iif(isNull(FechaHoraInicio) || trim(toString(FechaHoraInicio)) == '', toTimestamp(null()),\r",
				"    iif(instr(toString(FechaHoraInicio), ' ') > 0, \r",
				"        toTimestamp(trim(toString(FechaHoraInicio)), 'yyyy-MM-dd HH:mm:ss'),\r",
				"        iif(instr(toString(FechaHoraInicio), '/') > 0, \r",
				"            toTimestamp(trim(toString(FechaHoraInicio)), 'dd/MM/yyyy'),\r",
				"            toTimestamp(trim(toString(FechaHoraInicio)), 'yyyy-MM-dd')\r",
				"        )\r",
				"    )\r",
				"),",
				"          FechaHoraFin = iif(isNull(FechaHoraFin) || trim(toString(FechaHoraFin)) == '', toTimestamp(null()),\r",
				"    iif(instr(toString(FechaHoraFin), ' ') > 0, \r",
				"        toTimestamp(trim(toString(FechaHoraFin)), 'yyyy-MM-dd HH:mm:ss'),\r",
				"        iif(instr(toString(FechaHoraFin), '/') > 0, \r",
				"            toTimestamp(trim(toString(FechaHoraFin)), 'dd/MM/yyyy'),\r",
				"            toTimestamp(trim(toString(FechaHoraFin)), 'yyyy-MM-dd')\r",
				"        )\r",
				"    )\r",
				"),",
				"          FechaHoraRegistro = iif(isNull(FechaHoraRegistro) || trim(toString(FechaHoraRegistro)) == '', toTimestamp(null()),\r",
				"    iif(instr(toString(FechaHoraRegistro), ' ') > 0, \r",
				"        toTimestamp(trim(toString(FechaHoraRegistro)), 'yyyy-MM-dd HH:mm:ss'),\r",
				"        iif(instr(toString(FechaHoraRegistro), '/') > 0, \r",
				"            toTimestamp(trim(toString(FechaHoraRegistro)), 'dd/MM/yyyy'),\r",
				"            toTimestamp(trim(toString(FechaHoraRegistro)), 'yyyy-MM-dd')\r",
				"        )\r",
				"    )\r",
				")) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as timestamp,",
				"          FechaHoraFin as timestamp,",
				"          FechaHoraRegistro as timestamp,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          IncidenteId,",
				"          TipoIncidente,",
				"          Severidad,",
				"          FechaHoraInicio,",
				"          FechaHoraFin,",
				"          FechaHoraRegistro,",
				"          VehiculoId,",
				"          Descripcion",
				"     )) ~> sink1"
			]
		}
	}
}